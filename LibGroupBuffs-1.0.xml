<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!--
        Embedded into a consuming addon through .pkgmeta externals, e.g.

            externals:
              Libs/LibGroupBuffs-1.0:
                url: https://github.com/Spotnick2/LibGroupBuffs

        and then loaded from that addon's TOC before any of its own files:

            Libs\LibGroupBuffs-1.0\LibGroupBuffs-1.0.xml

        LibStub is bundled rather than pulled separately: it is designed to be
        embedded many times over and resolves to a single instance at runtime.
    -->
    <!--
        Only files that exist. A missing file here is a load error in every
        addon that embeds the library, and tests/harness.lua loads exactly this
        list so the suite fails the same way the client would.
    -->
    <Script file="LibStub\LibStub.lua"/>
    <Script file="Compat.lua"/>
    <Script file="Settings.lua"/>
    <Script file="Engine.lua"/>
</Ui>
